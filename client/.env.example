# URL pública del backend (Render), SIN slash final. Déjala vacía en desarrollo
# local (Vite usa el proxy definido en vite.config.js hacia localhost:4000).
#
# En Vercel, configura esta variable en el dashboard del proyecto
# (Settings → Environment Variables), NO la pongas en un archivo .env que subas a git:
# VITE_API_URL=https://freesoul-feedback-api.onrender.com
VITE_API_URL=

# Multi-marca (ver client/src/brands.js) — normalmente se deja vacía: la
# marca se resuelve sola por el prefijo de la URL (ej. /alas para Alas de
# Amara, sin prefijo para Free Soul). Solo se define esta variable cuando
# esa marca se despliega por separado, con su propio dominio: fuerza esa
# marca sin necesitar ningún prefijo de ruta.
# VITE_BRAND=alas-de-amara
VITE_BRAND=
