node_modules/
dist/

# Variables de entorno reales (nunca subir secretos) — los .env.example sí se suben
.env
.env.*
!.env.example
!**/.env.example

server/data/db.json
server/data/db.*.json
server/uploads/*
!server/uploads/.gitkeep
server/credentials/*
!server/credentials/.gitkeep

# Red de seguridad extra: nunca subir un JSON de Service Account de Google
# aunque quede suelto fuera de server/credentials/ (nombre típico descargado
# de Google Cloud: <project>-<hash>.json).
/*-*.json
!package.json
!package-lock.json

*.log
dev-log.txt
tunnel-log.txt
tunnel-err.txt
cloudflared.exe
