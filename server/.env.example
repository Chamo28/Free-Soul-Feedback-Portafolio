# Puerto del servidor. En Render se inyecta solo, no lo definas ahí.
PORT=4000

# Contraseña del panel admin (cámbiala)
ADMIN_PASSWORD=cambia-esta-clave

# Secreto para firmar el token de sesión del admin (cambia por algo aleatorio largo)
JWT_SECRET=cambia-este-secreto-tambien

# Dominio(s) del frontend que pueden llamar a esta API, separados por coma.
# Desarrollo local: déjala vacía (permite cualquier origen).
# Producción: pon aquí tu URL de Vercel y/o tu dominio propio, ej:
# CORS_ORIGIN=https://freesoul-feedback.vercel.app,https://test.freesoulfashion.com.co
CORS_ORIGIN=

# --- Google Sheets (opcional al inicio) ---
# Ver README.md sección "Configurar Google Sheets" para el paso a paso completo.

# Desarrollo local: ruta a un archivo JSON de credenciales en disco.
GOOGLE_SERVICE_ACCOUNT_JSON=./credentials/service-account.json

# Producción (Render): el mismo archivo JSON pero codificado en base64 y
# pegado como variable de entorno (no se sube el archivo a git). Genera el
# valor con:  node -e "console.log(require('fs').readFileSync('server/credentials/service-account.json').toString('base64'))"
# Si defines esta variable, tiene prioridad sobre GOOGLE_SERVICE_ACCOUNT_JSON.
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=

# ID de la hoja de cálculo (está en la URL de tu Google Sheet):
# https://docs.google.com/spreadsheets/d/ESTE_ES_EL_ID/edit
GOOGLE_SHEET_ID=

# Nombre de la pestaña dentro del Sheet donde se guardan las respuestas de la encuesta detallada
GOOGLE_SHEET_TAB=Respuestas

# --- Marca "Alas de Amara" (multi-marca — ver server/src/brands.js) ---
# Mismo código, misma cuenta de servicio de Google, pero su propia hoja de
# cálculo y su propia contraseña de admin — completamente separado de los
# datos de Free Soul DNA. Sin estas variables, la marca simplemente muestra
# "no configurado" en vez de fallar.
ALAS_ADMIN_PASSWORD=
ALAS_GOOGLE_SHEET_ID=
ALAS_GOOGLE_SHEET_TAB=Respuestas
